{"sentence_id": "ORG-NOTICE-007", "exact_text": "You have unlimited number of pages for references and appendix, but the main part of the paper must be within maximum 8 pages.", "exact_text_sha256": "af2e0aaf7af4ba781660c25751dadf9fec2fcc0a93701100aa0a48dc4492f288", "supporting_atom_ids": ["REQ-PAGES-001", "REQ-PAGES-002", "REQ-PAGES-003", "REQ-REF-001", "REQ-REF-002", "REQ-REF-003", "REQ-REF-004"], "support_state": "SUPPORTED", "derivation_type": "DETERMINISTIC_COMPUTATION"}
