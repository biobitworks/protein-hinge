# Credentials never enter this repo. They live in .env and .env stays out.
.env
.env.*
!.env.example
*.pem
*.key

__pycache__/
*.pyc
.DS_Store
__MACOSX/
.playwright-cli/
node_modules/

# Generated NewInML submission seal outputs (authoritative copies live in CI artifacts).
paper/newinml2026/submission/dist/
paper/newinml2026/submission/_repro_build_run1.pdf

# Nothing under fcg/store/ is ignored, on purpose. The whole store is 532K,
# the atoms are 37K, and those atoms are the difference between RECOMPUTED and
# COMMITTED: without the bytes, a reader can only take the digests on trust.
# Large upstream files (the 13 MB parquets, the JUMP metadata) are never
# vendored here — they are attested by digest and re-fetched from origin.
